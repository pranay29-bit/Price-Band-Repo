//@version=5
indicator("Circuit Band Table (Pine Seeds)", overlay=true)

// ───────────────────────────── Inputs ─────────────────────────────
grp = "Pine Seeds Source"
seedPrefixInput = input.string("SEED_yourprefix_BAND", "Band Seed Prefix (without :SYMBOL)", group=grp,
     tooltip="Once TradingView approves your Pine Seeds repo, your band feed will be reachable as e.g. SEED_yourprefix_BAND:RELIANCE. Enter the prefix here (before the colon).")

grp2 = "Display Settings"
showTable  = input.bool(true, "Show Info Table", group=grp2)
darkMode   = input.bool(false, "Dark Mode Table", group=grp2)
tableSizeInput = input.string("Normal", "Table Size", options=["Small", "Normal", "Large"], group=grp2)

// ───────────────────────────── Pull seeded band % ─────────────────────────────
seedTicker = seedPrefixInput + ":" + syminfo.ticker
bandPct = request.security(seedTicker, "D", close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

bandLabelText = na(bandPct) ? "N/A" :
     bandPct == 0 ? "FnO" :
     str.tostring(bandPct, "#") + "%"

prevClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
upperCircuit = (na(bandPct) or bandPct == 0) ? na : prevClose * (1 + bandPct / 100)
lowerCircuit = (na(bandPct) or bandPct == 0) ? na : prevClose * (1 - bandPct / 100)

tableSize = switch tableSizeInput
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large

bgCol  = darkMode ? color.new(color.black, 0) : color.new(color.white, 0)
txtCol = darkMode ? color.new(color.white, 0) : color.new(color.black, 0)

var table infoTable = table.new(position.top_right, 2, 4, border_width=1)

if showTable and barstate.islast
    table.cell(infoTable, 0, 0, "Symbol", bgcolor=bgCol, text_color=txtCol, text_size=tableSize)
    table.cell(infoTable, 1, 0, syminfo.ticker, bgcolor=bgCol, text_color=txtCol, text_size=tableSize)

    table.cell(infoTable, 0, 1, "Price Band", bgcolor=bgCol, text_color=txtCol, text_size=tableSize)
    table.cell(infoTable, 1, 1, bandLabelText, bgcolor=color.new(color.blue, 60), text_color=txtCol, text_size=tableSize)

    table.cell(infoTable, 0, 2, "Upper Circuit", bgcolor=bgCol, text_color=txtCol, text_size=tableSize)
    table.cell(infoTable, 1, 2, na(upperCircuit) ? "—" : str.tostring(upperCircuit, format.mintick), bgcolor=bgCol, text_color=color.green, text_size=tableSize)

    table.cell(infoTable, 0, 3, "Lower Circuit", bgcolor=bgCol, text_color=txtCol, text_size=tableSize)
    table.cell(infoTable, 1, 3, na(lowerCircuit) ? "—" : str.tostring(lowerCircuit, format.mintick), bgcolor=bgCol, text_color=color.red, text_size=tableSize)

plot(upperCircuit, title="Upper Circuit", color=color.new(color.green, 40), style=plot.style_circles)
plot(lowerCircuit, title="Lower Circuit", color=color.new(color.red, 40), style=plot.style_circles)
